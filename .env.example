# Environment Configuration
# Copy this file to .env and fill in the required values

# Required: The URL of your m0nitor API
API_URL=https://console.m0nitor.com/api

# Required: Your unique probe authentication token
PROBE_TOKEN=your-probe-token-here

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Polling interval in milliseconds (default: 5000)
POLL_INTERVAL=5000

# Optional: Skip SSL certificate verification (INSECURE - only for development)
# WARNING: Setting this to true allows man-in-the-middle attacks!
SKIP_SSL_VERIFY=false
