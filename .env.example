# Environment Configuration
# Copy this file to .env and fill in the required values

# Required: The base URL of the m0nitor API
API_URL=https://m0nitor.com/api

# Required: Your unique probe authentication token
PROBE_TOKEN=your-probe-token-here

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Polling interval in milliseconds
POLL_INTERVAL=5000

# Optional: Cap for exponential backoff under consecutive poll failures (ms).
# Set equal to POLL_INTERVAL to disable backoff.
POLL_MAX_INTERVAL=300000

# Optional: Skip SSL certificate verification (INSECURE - only for development)
# WARNING: Setting this to true allows man-in-the-middle attacks!
SKIP_SSL_VERIFY=false

# Optional: Global override for the SSRF guard (INSECURE). When true, the worker
# accepts monitor targets that resolve to private/reserved IPs. Only for
# self-hosted operators monitoring a trusted LAN. A per-monitor flag takes
# precedence. Leave false unless you trust every monitor target.
ALLOW_PRIVATE_TARGETS=false

# Optional: Default address family for checks when a monitor does not specify one
# (auto | ipv4 | ipv6). auto lets the OS choose. A per-monitor family always
# takes precedence.
IP_FAMILY=auto

# Optional: Discover public egress IPv4 and IPv6 (reported via X-Agent-Health for
# the m0nitor firewall allowlist at /ips-v4, /ips-v6, /ips.json). Disable for
# air-gapped self-hosted agents that cannot reach the echo endpoint.
EGRESS_DETECT=true
# EGRESS_DETECT_URL=https://cloudflare.com/cdn-cgi/trace
# EGRESS_DETECT_TTL_MS=900000
# EGRESS_DETECT_TIMEOUT_MS=5000

# Optional: Port for the health check HTTP server
HEALTH_PORT=8080

# Optional: Force a SKU profile (sku-1c1g | sku-2c2g | sku-2c4g).
# Leave empty to auto-detect from cgroup limits (container) or host totals.
# AGENT_SKU=sku-1c1g

# Optional: Resource budgets. Defaults come from detected SKU / formula.
# CONCURRENCY_LIMIT=16
# NETWORK_CONCURRENCY=13
# DATABASE_CONCURRENCY=2
# DIAGNOSTIC_CONCURRENCY=1
# HTTP_MAX_SOCKETS=6
# HTTP_MAX_FREE_SOCKETS=2

# Optional: Bounded result buffering, micro-batch reporting, and governor
# RESULT_QUEUE_MAX_ENTRIES=500
# RESULT_QUEUE_MAX_BYTES=4194304
# REPORT_BATCH_MAX_SIZE=50
# REPORT_BATCH_MAX_BYTES=524288
# REPORT_COALESCE_IDLE_MS=30
# REPORT_MAX_IN_FLIGHT=2
# SOFT_RSS_BYTES=367001600
# HARD_RSS_BYTES=576716800
# SHUTDOWN_FLUSH_TIMEOUT=5000
